<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Двухдатная модель события: помимо date_start (когда событие
        наступает) появляется announce_date (когда о нём стало известно).
        Для большинства событий обе даты совпадают; для "Выплаты
        дивидендов" announce_date = announcement_date соответствующей
        строки в таблице dividends, что позволяет no-lookahead-фильтру
        видеть будущие выплаты, о которых уже объявлено.

        Заодно в events добавляется payload JSONB — место для специфики
        конкретного типа события (для дивидендов: ticker,
        dividend_per_share, year). Таблица dividends схлопывается в
        events: её данные уезжают в payload, сама таблица удаляется.
    -->

    <changeSet id="004-events-announce-date-payload" author="ruslan">

        <addColumn tableName="events">
            <column name="announce_date" type="DATE"/>
            <column name="payload" type="JSONB"/>
        </addColumn>

        <!-- Дефолт: announce_date = date_start (анонс совпадает с
             наступлением — справедливо для всех событий, кроме выплат
             дивидендов). -->
        <sql>
            UPDATE events SET announce_date = date_start
        </sql>

        <!-- Для "Выплат дивидендов" announce_date берётся из
             dividends.announcement_date по матчу (ticker, payment_date).
             Тикер парсится из текста события: 'Выплата дивидендов
             SBER: ...' → 'SBER'. -->
        <sql>
            UPDATE events e
               SET announce_date = d.announcement_date
              FROM dividends d
             WHERE e.event LIKE 'Выплата дивидендов %'
               AND substring(e.event from 'дивидендов (\w+):') = d.ticker
               AND e.date_start = d.payment_date
        </sql>

        <addNotNullConstraint tableName="events" columnName="announce_date"/>

        <!-- Обогащение payload для всех дивидендных событий
             (объявление + выплата) одним и тем же содержимым:
             ticker, dividend_per_share, year. -->
        <sql>
            UPDATE events e
               SET payload = jsonb_build_object(
                       'ticker', d.ticker,
                       'dividend_per_share', d.dividend_per_share,
                       'year', d.year
                   )
              FROM dividends d
             WHERE substring(e.event from 'дивидендов (\w+):') = d.ticker
               AND (
                    (e.event LIKE 'Объявление дивидендов %'
                     AND e.date_start = d.announcement_date)
                 OR (e.event LIKE 'Выплата дивидендов %'
                     AND e.date_start = d.payment_date)
                   )
        </sql>

        <!-- Пересоздать tagged_events с announce_date и payload.
             DROP+CREATE, потому что CREATE OR REPLACE VIEW не
             позволяет менять порядок колонок. -->
        <sql>
            DROP VIEW IF EXISTS tagged_events
        </sql>
        <sql>
            CREATE VIEW tagged_events AS
            SELECT
                e.id            AS event_id,
                e.date_start,
                e.date_end,
                e.announce_date,
                e.event,
                e.payload,
                t.code          AS tag,
                t.name          AS tag_name,
                t.type          AS tag_type
            FROM events     e
            JOIN event_tags et ON et.event_id = e.id
            JOIN tags       t  ON t.code      = et.tag_code
        </sql>

        <dropTable tableName="dividends"/>

    </changeSet>

</databaseChangeLog>
