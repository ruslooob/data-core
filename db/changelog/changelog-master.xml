<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Мастер-changelog для миграций data-core. Каждое изменение схемы или
        PL/Python-функции добавляется отдельным файлом в каталоге `changes/`
        и подключается через <include>. Формат имён: NNN-короткое-описание.xml,
        порядковый префикс задаёт порядок применения. Один changeset =
        одно атомарное изменение. Запуск см. в docker-compose.yml.
    -->

    <include file="changes/001-initial-schema.xml" relativeToChangelogFile="true"/>
    <include file="changes/002-udfs.xml" relativeToChangelogFile="true"/>
    <include file="changes/003-seed-default-research.xml" relativeToChangelogFile="true"/>
    <include file="changes/004-events-announce-date-payload.xml" relativeToChangelogFile="true"/>
    <include file="changes/005-events-search-index.xml" relativeToChangelogFile="true"/>
    <include file="changes/006-corporate-and-macro-tags-and-drop-stocks-splits.xml" relativeToChangelogFile="true"/>
    <include file="changes/007-emitters-and-corp-disclosure.xml" relativeToChangelogFile="true"/>
    <include file="changes/008-corp-disclosure-extended-tags.xml" relativeToChangelogFile="true"/>
    <include file="changes/009-merge-report-consolidated-into-ifrs.xml" relativeToChangelogFile="true"/>
    <include file="changes/010-drop-material-event-tag.xml" relativeToChangelogFile="true"/>
    <include file="changes/011-add-spo-tag.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
